{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"cleanUrls": false,
	"trailingSlash": false,
	"headers": [
		{
			"source": "/assets/textures/(.*)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
			]
		},
		{
			"source": "/vendor/(.*)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
			]
		},
		{
			"source": "/js/(.*)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
			]
		}
	]
}
